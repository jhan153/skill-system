{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-system.local/schemas/report-canvas/report-model.schema.json",
  "title": "Skill System Report Canvas Model",
  "description": "Host-neutral source model for the default human-facing Report Canvas HTML projection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "language",
    "title",
    "summary",
    "status",
    "evidence_status",
    "next_action",
    "visual"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "decision",
        "compare",
        "trace",
        "spatial"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "eyebrow": {
      "type": "string",
      "maxLength": 80,
      "description": "Optional dimension the title and mode do not already say (named target, snapshot, date). Omit rather than restating the product or mode."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "status": {
      "enum": [
        "info",
        "pass",
        "revise",
        "reject",
        "escalate",
        "abstain",
        "blocked",
        "unverified"
      ]
    },
    "evidence_status": {
      "enum": [
        "verified",
        "mixed",
        "unverified",
        "user-verification-needed"
      ]
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "findings": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "next_action": {
      "$ref": "#/$defs/action"
    },
    "visual": {
      "oneOf": [
        {
          "$ref": "#/$defs/decisionVisual"
        },
        {
          "$ref": "#/$defs/compareVisual"
        },
        {
          "$ref": "#/$defs/traceVisual"
        },
        {
          "$ref": "#/$defs/spatialVisual"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "participation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/participation"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "ref": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "title",
        "summary"
      ],
      "properties": {
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label"
      ],
      "properties": {
        "kind": {
          "enum": [
            "next",
            "none"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "detail": {
          "type": "string",
          "maxLength": 700
        },
        "href": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "consequence": {
          "type": "string",
          "maxLength": 500
        },
        "recommended": {
          "type": "boolean"
        }
      }
    },
    "decisionVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "prompt",
        "choices"
      ],
      "properties": {
        "type": {
          "const": "decision"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/choice"
          }
        }
      }
    },
    "contentBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "content"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "content": {
          "type": "string",
          "maxLength": 10000
        },
        "language": {
          "type": "string",
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "maxLength": 40
        }
      }
    },
    "compareVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "before",
        "after"
      ],
      "properties": {
        "type": {
          "const": "compare"
        },
        "before_label": {
          "type": "string",
          "maxLength": 80
        },
        "after_label": {
          "type": "string",
          "maxLength": 80
        },
        "before": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentBlock"
          }
        },
        "after": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentBlock"
          }
        }
      }
    },
    "traceNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "detail": {
          "type": "string",
          "maxLength": 700
        },
        "status": {
          "enum": [
            "verified",
            "observed",
            "inferred",
            "unverified",
            "blocked"
          ]
        },
        "lifecycle_status": {
          "enum": [
            "planned",
            "not_executed",
            "evidence_unavailable",
            "needs_review",
            "user_verification_needed",
            "blocked",
            "fail"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "traceEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "traceVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "trace_kind",
        "nodes",
        "edges"
      ],
      "properties": {
        "type": {
          "const": "trace"
        },
        "trace_kind": {
          "enum": [
            "causal",
            "lifecycle"
          ]
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/traceNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/traceEdge"
          }
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positions"
      ],
      "properties": {
        "positions": {
          "type": "array",
          "minItems": 9,
          "items": {
            "type": "number"
          }
        },
        "indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "normals": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "face_ids": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "vertex_ids": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        }
      }
    },
    "glbPathAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "path"
      ],
      "properties": {
        "format": {
          "const": "glb"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "mime_type": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "glbDataAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "data_base64"
      ],
      "properties": {
        "format": {
          "const": "glb"
        },
        "mime_type": {
          "type": "string",
          "maxLength": 100
        },
        "data_base64": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gltfPathAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "path"
      ],
      "properties": {
        "format": {
          "const": "gltf"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "mime_type": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "gltfDataAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "data_text"
      ],
      "properties": {
        "format": {
          "const": "gltf"
        },
        "mime_type": {
          "type": "string",
          "maxLength": 100
        },
        "data_text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bufferGeometryAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "geometry"
      ],
      "properties": {
        "format": {
          "const": "buffer_geometry"
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        }
      }
    },
    "spatialAsset": {
      "oneOf": [
        {
          "$ref": "#/$defs/glbPathAsset"
        },
        {
          "$ref": "#/$defs/glbDataAsset"
        },
        {
          "$ref": "#/$defs/gltfPathAsset"
        },
        {
          "$ref": "#/$defs/gltfDataAsset"
        },
        {
          "$ref": "#/$defs/bufferGeometryAsset"
        }
      ]
    },
    "issueOverlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label"
      ],
      "properties": {
        "kind": {
          "enum": [
            "selection",
            "non_manifold",
            "boundary",
            "degenerate",
            "added",
            "removed",
            "changed",
            "unknown"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "vertices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "faces": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "state_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          }
        }
      }
    },
    "spatialState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "asset"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "asset": {
          "$ref": "#/$defs/spatialAsset"
        }
      }
    },
    "spatialVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "asset"
      ],
      "properties": {
        "type": {
          "const": "spatial"
        },
        "purpose": {
          "enum": [
            "display",
            "topology"
          ],
          "description": "display = inspectable sampled or supplied shape. topology = overlays or identity arrays are issue evidence."
        },
        "asset": {
          "$ref": "#/$defs/spatialAsset"
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spatialState"
          }
        },
        "overlays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issueOverlay"
          }
        },
        "initial_state": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "caption": {
          "type": "string",
          "maxLength": 700
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "kind",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "status": {
          "enum": [
            "verified",
            "observed",
            "inferred",
            "unverified",
            "conflicting"
          ]
        },
        "kind": {
          "enum": [
            "intent",
            "source",
            "runtime",
            "test",
            "diff",
            "external",
            "unknown"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "summary": {
          "type": "string",
          "maxLength": 1200
        },
        "details": {
          "type": "string",
          "maxLength": 30000
        },
        "href": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "participation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status"
      ],
      "properties": {
        "kind": {
          "enum": [
            "explainer_generated",
            "scenario_exercised",
            "behavior_compared",
            "decision_confirmed",
            "assumption_delegated"
          ]
        },
        "status": {
          "enum": [
            "observed",
            "unverified"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  }
}
