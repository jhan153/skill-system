{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-system-loop-contract.schema.json",
  "title": "Skill System Loop Contract",
  "type": "object",
  "required": ["schema_version", "contract_id", "activation", "goal", "control", "termination"],
  "properties": {
    "schema_version": { "enum": [1, 2, 3] },
    "contract_id": {
      "type": "string",
      "pattern": "^LC-[0-9]{8}-[0-9]{3}$"
    },
    "activation": { "enum": ["explicit"] },
    "goal": {
      "type": "object",
      "required": ["statement", "success_conditions"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "success_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "statement", "verifier"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^SC-[0-9]{3}$"
              },
              "statement": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" },
              "work_kind": {
                "enum": [
                  "core",
                  "required_prerequisite",
                  "agent_validation",
                  "test_authoring",
                  "validation_artifact",
                  "optional_quality",
                  "meta"
                ]
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^SC-[0-9]{3}$"
                }
              },
              "interaction_required": { "type": "boolean" },
              "intent_key": { "type": "string", "minLength": 1 },
              "verifier": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": {
                    "enum": ["command_exit", "artifact_exists", "manual_check", "diff_scope"]
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Stable identity responsible for this verifier; pass receipts must match it exactly."
                  },
                  "command": { "type": "string", "minLength": 1 },
                  "expected_exit_code": { "type": "integer" },
                  "path": { "type": "string", "minLength": 1 },
                  "acceptance_scope": { "type": "string", "minLength": 1 }
                },
                "allOf": [
                  {
                    "if": {
                      "required": ["type"],
                      "properties": { "type": { "const": "command_exit" } }
                    },
                    "then": { "required": ["command"] }
                  },
                  {
                    "if": {
                      "required": ["type"],
                      "properties": { "type": { "const": "artifact_exists" } }
                    },
                    "then": { "required": ["path"] }
                  },
                  {
                    "if": {
                      "required": ["type"],
                      "properties": { "type": { "const": "manual_check" } }
                    },
                    "then": { "required": ["acceptance_scope"] }
                  },
                  {
                    "if": {
                      "required": ["type"],
                      "properties": { "type": { "const": "diff_scope" } }
                    },
                    "then": { "required": ["path"] }
                  }
                ],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "statement", "verifier"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^INV-[0-9]{3}$"
              },
              "statement": { "type": "string", "minLength": 1 },
              "verifier": { "type": "object" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "work_contract": { "$ref": "#/$defs/workContract" },
    "scope": { "type": "object" },
    "control": {
      "type": "object",
      "required": ["max_iterations", "no_progress_limit", "same_failure_limit", "max_stop_continuations"],
      "properties": {
        "max_iterations": { "type": "integer", "minimum": 1 },
        "max_wall_time_seconds": { "type": "integer", "minimum": 0 },
        "no_progress_limit": { "type": "integer", "minimum": 1 },
        "same_failure_limit": { "type": "integer", "minimum": 1 },
        "oscillation_limit": { "type": "integer", "minimum": 1 },
        "max_stop_continuations": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "recovery": { "type": "object" },
    "termination": {
      "type": "object",
      "required": ["precedence"],
      "properties": {
        "precedence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["unsafe", "fatal", "blocked", "success", "user_verification_needed", "approval_required", "stalled", "budget_exhausted", "recover", "continue"]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": 3 } },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["work_contract"],
        "properties": {
          "goal": {
            "properties": {
              "success_conditions": {
                "items": {
                  "required": [
                    "work_kind",
                    "depends_on",
                    "interaction_required",
                    "intent_key"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "workContract": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_id",
        "source",
        "execution",
        "scope",
        "verification",
        "interaction",
        "continuation",
        "termination"
      ],
      "properties": {
        "schema_version": { "enum": [1] },
        "contract_id": {
          "type": "string",
          "pattern": "^WC-[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "source": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": ["natural_language", "requirements_contract", "plan", "loop_contract"]
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "ref": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "execution": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["attended", "unattended_goal_loop"] }
          },
          "additionalProperties": false
        },
        "scope": {
          "type": "object",
          "required": ["core_deliverables", "allowed_action_classes", "excluded_action_classes"],
          "properties": {
            "core_deliverables": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "allowed_action_classes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "core",
                  "required_prerequisite",
                  "agent_validation",
                  "test_authoring",
                  "validation_artifact",
                  "optional_quality",
                  "meta"
                ]
              }
            },
            "excluded_action_classes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "core",
                  "required_prerequisite",
                  "agent_validation",
                  "test_authoring",
                  "validation_artifact",
                  "optional_quality",
                  "meta"
                ]
              }
            },
            "non_goals": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        "verification": {
          "type": "object",
          "required": ["owner", "handoff_on_unavailable"],
          "properties": {
            "owner": { "enum": ["agent", "user", "shared", "external"] },
            "handoff_on_unavailable": {
              "enum": ["user-verification-needed", "unverified", "blocked"]
            }
          },
          "additionalProperties": false
        },
        "interaction": {
          "type": "object",
          "required": ["mode", "approval_behavior", "question_behavior"],
          "properties": {
            "mode": { "enum": ["allowed", "forbidden"] },
            "approval_behavior": { "enum": ["normal", "defer"] },
            "question_behavior": { "enum": ["normal", "defer"] }
          },
          "additionalProperties": false
        },
        "continuation": {
          "type": "object",
          "required": [
            "on_local_block",
            "on_optional_failure",
            "duplicate_intent_behavior",
            "global_block_condition"
          ],
          "properties": {
            "on_local_block": { "const": "reevaluate_remaining_work" },
            "on_optional_failure": { "const": "continue" },
            "duplicate_intent_behavior": { "const": "defer_same_intent" },
            "global_block_condition": { "const": "no_required_runnable_work" }
          },
          "additionalProperties": false
        },
        "termination": {
          "type": "object",
          "required": ["stop_condition"],
          "properties": {
            "time_budget_seconds": { "type": ["integer", "null"], "minimum": 0 },
            "stop_condition": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
