# Destructive local operations that a turn-level grant must never broaden.
prefix_rule(pattern=["git", "reset", "--hard"], decision="forbidden", justification="Use a targeted restore or revert instead.")
prefix_rule(pattern=["git", "clean", ["-f", "--force", "-fd", "-df", "-fdx", "-fxd", "-dfx", "-dxf", "-xfd", "-xdf"]], decision="forbidden", justification="Review untracked files and use targeted cleanup.")
prefix_rule(pattern=["git", "clean", "-f", "-d"], decision="forbidden", justification="Review untracked files and use targeted cleanup.")
prefix_rule(pattern=["git", "clean", "-f", "-d", "-x"], decision="forbidden", justification="Review untracked files and use targeted cleanup.")
prefix_rule(pattern=["git", "clean", "-d", "-f"], decision="forbidden", justification="Review untracked files and use targeted cleanup.")
prefix_rule(pattern=["git", "clean", ["-d", "--directories", "-x", "--ignored", "-X"], ["-f", "--force"]], decision="forbidden", justification="Review untracked files and use targeted cleanup.")
prefix_rule(pattern=["git", "clean", ["-d", "--directories", "-x", "--ignored", "-X"], ["-d", "--directories", "-x", "--ignored", "-X"], ["-f", "--force"]], decision="forbidden", justification="Review untracked files and use targeted cleanup.")
prefix_rule(pattern=["git", "-c", ["clean.requireForce=false", "clean.requireforce=false"], "clean"], decision="forbidden", justification="Review untracked files and use targeted cleanup.")

# Prefer direct commands, but route shell semantics that cannot be decomposed
# without changing meaning to Codex Auto-review.
prefix_rule(
    pattern=[["sh", "bash", "zsh", "/bin/sh", "/bin/bash", "/bin/zsh"], ["-c", "-lc", "-ic", "-ilc", "-cl", "-lic"]],
    decision="prompt",
    justification="Auto-review the complete shell expression and its effects before execution.",
    match=["zsh -lc 'rg -n TODO source'"],
    not_match=["rg -n TODO source"],
)

# General-purpose inline evaluators hide file, process, credential, and network
# behavior behind an interpreter prefix. Route them to Auto-review rather than
# terminating them before PermissionRequest.
prefix_rule(pattern=[["python", "python3", "/usr/bin/python", "/usr/bin/python3"], "-c"], decision="prompt", justification="Review the complete inline program and its effects before execution.")
prefix_rule(pattern=["node", ["-e", "--eval", "-p", "--print"]], decision="prompt", justification="Review the complete inline program and its effects before execution.")
prefix_rule(pattern=[["ruby", "perl", "osascript", "lua", "Rscript"], ["-e", "-E"]], decision="prompt", justification="Review the complete inline program and its effects before execution.")
prefix_rule(pattern=[["pwsh", "powershell"], ["-c", "-Command", "-command", "-EncodedCommand", "-encodedcommand"]], decision="prompt", justification="Review the complete inline program and its effects before execution.")
prefix_rule(pattern=["php", "-r"], decision="prompt", justification="Review the complete inline program and its effects before execution.")
prefix_rule(pattern=["deno", "eval"], decision="prompt", justification="Review the complete inline program and its effects before execution.")

# Effects that require Auto-review. A prompt does not infer or broaden task
# authority, target scope, sandbox access, or hard-safety policy.
prefix_rule(pattern=["rm"], decision="prompt", justification="Deletion requires an explicit in-scope cleanup grant.")
prefix_rule(pattern=["find"], decision="prompt", justification="Review the complete find expression because actions such as -delete and -exec can mutate state or launch processes.")
prefix_rule(pattern=[["rsync", "cp", "mv", "mkdir", "install"]], decision="prompt", justification="Filesystem mutation must stay within the current turn's declared target.")
prefix_rule(pattern=[["python", "python3"], "-m", "pip", "install"], decision="prompt", justification="Dependency installation changes the environment and may use the network.")
prefix_rule(pattern=["uv", "pip", "install"], decision="prompt", justification="Dependency installation changes the environment and may use the network.")
prefix_rule(pattern=[["npm", "pnpm", "yarn", "bun"], ["install", "i", "add", "update", "upgrade"]], decision="prompt", justification="Package operations change the workspace or environment and may use the network.")
prefix_rule(pattern=["cargo", ["add", "install", "update"]], decision="prompt", justification="Cargo dependency operations change manifests, caches, or installed tools.")
prefix_rule(pattern=["brew", ["install", "upgrade"]], decision="prompt", justification="Homebrew operations change the host environment and use the network.")
prefix_rule(pattern=[["curl", "wget"]], decision="prompt", justification="Network requests can transmit task or local data.")
prefix_rule(pattern=["git", ["clone", "fetch", "ls-remote", "pull", "push", "submodule"]], decision="prompt", justification="Remote Git operations require an explicit current-turn network or publication grant.")
prefix_rule(pattern=["git", "branch", ["-D", "-d", "-f", "-m"]], decision="prompt", justification="Branch deletion or force movement requires explicit current-turn authority.")
prefix_rule(pattern=["git", "rebase"], decision="prompt", justification="History rewriting requires an explicit current-turn grant.")
prefix_rule(pattern=["git", "restore", "--staged"], decision="prompt", justification="Git index mutation must remain inside the current implementation scope.")
prefix_rule(pattern=["git", "checkout", "--ours"], decision="prompt", justification="Conflict resolution must remain inside the current implementation scope.")
prefix_rule(pattern=["git", "worktree", "add"], decision="prompt", justification="Creating another checkout requires an explicit current-turn target.")
prefix_rule(pattern=[["kill", "pkill", "lldb"]], decision="prompt", justification="Process termination and debugger attachment require an explicit process grant.")
prefix_rule(pattern=[["codex", "claude"], ["plugin", "mcp", "app-server"]], decision="prompt", justification="Agent runtime operations can change installed or running host state.")
prefix_rule(pattern=["launchctl", "setenv"], decision="prompt", justification="Changing process-manager environment state requires an explicit host-runtime grant.")
prefix_rule(pattern=["open", "-R"], decision="prompt", justification="Launching a host GUI requires an explicit process-launch grant.")

# Do not grant unsandboxed execution from an executable prefix alone. Local work runs in the
# sandbox; these prompt overrides route historical default allowlists through Auto-review so the
# reviewer can inspect arguments, targets, and effects. More-specific forbidden rules still win.
prefix_rule(pattern=[["mmdc", "rg"]], decision="prompt", justification="Auto-review the complete command, target, and effects.")
prefix_rule(pattern=["cmake", ["-S", "--build", "--preset"]], decision="prompt", justification="Auto-review the build target and effects.")
prefix_rule(pattern=["ctest", ["--test-dir", "--preset"]], decision="prompt", justification="Auto-review the selected test target and effects.")
prefix_rule(pattern=["git"], decision="prompt", justification="Auto-review the complete Git command, repository target, and effects.")
prefix_rule(pattern=["python3", "source/tools/generate_targets.py"], decision="prompt", justification="Auto-review generated-target writes.")
prefix_rule(pattern=["go", "test"], decision="prompt", justification="Auto-review test execution and side effects.")
