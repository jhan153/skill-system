            "type": "command",
            "command": "__ABSOLUTE_SKILL_SYSTEM_CLAUDE_HARNESS__",
            "args": [],
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__ABSOLUTE_SKILL_SYSTEM_CLAUDE_HARNESS__",
            "args": [],
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__ABSOLUTE_SKILL_SYSTEM_CLAUDE_HARNESS__",
            "args": [],
            "timeout": 3
          }
        ]
      }
    ],
    "Notification": [
