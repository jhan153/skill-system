{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-system-research-ledger.schema.json",
  "title": "Skill System Research Evidence Ledger",
  "type": "object",
  "required": ["schema_version", "ledger_id", "topic", "created_at", "entries"],
  "properties": {
    "schema_version": {"const": 2},
    "ledger_id": {"type": "string", "pattern": "^RL-[0-9]{8}-[0-9]{3}$"},
    "topic": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "entry_id",
          "source_id",
          "claim",
          "acquisition_status",
          "source_status",
          "claim_relation",
          "evidence_basis",
          "locator",
          "limitation",
          "verification_status",
          "local_consumers"
        ],
        "properties": {
          "entry_id": {"type": "string", "pattern": "^RLE-[0-9]{3}$"},
          "source_id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "acquisition_status": {"enum": ["acquired", "partial", "inaccessible", "not_acquired"]},
          "source_status": {
            "enum": ["verified_identity", "metadata_partial", "duplicate_version", "corrected", "retracted", "unverified"]
          },
          "claim_relation": {"enum": ["supports", "contradicts", "mixed", "mentions", "not_assessed"]},
          "evidence_basis": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "provenance": {"enum": ["user_provided", "local_observation"]},
          "limitation": {"type": "string"},
          "verification_status": {"enum": ["agent-verified", "user-verification-needed", "unverified"]},
          "local_consumers": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
