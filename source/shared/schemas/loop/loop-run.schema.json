{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-system-loop-run.schema.json",
  "title": "Skill System Loop Run State",
  "type": "object",
  "required": [
    "schema_version",
    "loop_run_id",
    "contract_ref",
    "contract_hash",
    "workspace",
    "status",
    "iteration",
    "started_at",
    "updated_at",
    "budgets",
    "condition_results",
    "progress",
    "agent_run_refs",
    "last_decision",
    "side_effect_journal"
  ],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "loop_run_id": {
      "type": "string",
      "pattern": "^LR-[0-9]{8}-[0-9]{3}$"
    },
    "contract_ref": { "type": "string", "minLength": 1 },
    "contract_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "workspace": {
      "type": "object",
      "required": ["root", "revision", "workspace_id"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "workspace_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": ["active", "success", "user_verification_needed", "blocked", "budget_exhausted", "unsafe", "fatal", "stalled"]
    },
    "result_label": {
      "enum": ["pending", "agent-verified", "user-verification-needed", "unverified", "blocked"]
    },
    "iteration": { "type": "integer", "minimum": 0 },
    "started_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "budgets": {
      "type": "object",
      "required": ["iterations_used", "max_iterations", "stop_continuations_used", "max_stop_continuations"],
      "properties": {
        "iterations_used": { "type": "integer", "minimum": 0 },
        "max_iterations": { "type": "integer", "minimum": 1 },
        "stop_continuations_used": { "type": "integer", "minimum": 0 },
        "max_stop_continuations": { "type": "integer", "minimum": 0 },
        "wall_time_seconds": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "condition_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["condition_id", "status", "evidence_refs"],
        "properties": {
          "condition_id": {
            "type": "string",
            "pattern": "^SC-[0-9]{3}$"
          },
          "status": { "enum": ["pass", "fail", "unverified", "blocked", "deferred"] },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "verifier_owner", "observed_at", "outcome"],
              "properties": {
                "kind": {
                  "enum": ["command_exit", "artifact_exists", "manual_acceptance", "diff_scope"]
                },
                "verifier_owner": { "type": "string", "minLength": 1 },
                "observed_at": { "type": "string", "format": "date-time" },
                "outcome": {
                  "enum": ["pass", "fail", "unverified", "blocked", "user-verification-needed"]
                },
                "artifact_ref": { "type": "string", "minLength": 1 },
                "artifact_scope": { "enum": ["loop_run", "workspace"] },
                "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "command": { "type": "string", "minLength": 1 },
                "exit_code": { "type": "integer" },
                "actor": { "type": "string", "minLength": 1 },
                "actor_type": { "enum": ["user"] },
                "accepted_scope": { "type": "string", "minLength": 1 },
                "accepted": { "enum": [true] },
                "checked_path": { "type": "string", "minLength": 1 }
              },
              "allOf": [
                {
                  "if": {
                    "required": ["kind"],
                    "properties": { "kind": { "const": "command_exit" } }
                  },
                  "then": {
                    "required": ["artifact_ref", "artifact_scope", "artifact_sha256", "command", "exit_code"]
                  }
                },
                {
                  "if": {
                    "required": ["kind"],
                    "properties": { "kind": { "const": "artifact_exists" } }
                  },
                  "then": {
                    "required": ["artifact_ref", "artifact_scope", "artifact_sha256"]
                  }
                },
                {
                  "if": {
                    "required": ["kind"],
                    "properties": { "kind": { "const": "diff_scope" } }
                  },
                  "then": {
                    "required": ["artifact_ref", "artifact_scope", "artifact_sha256"]
                  }
                },
                {
                  "if": {
                    "required": ["kind"],
                    "properties": { "kind": { "const": "manual_acceptance" } }
                  },
                  "then": {
                    "required": [
                      "artifact_ref",
                      "artifact_scope",
                      "artifact_sha256",
                      "actor",
                      "actor_type",
                      "accepted_scope",
                      "accepted"
                    ]
                  }
                }
              ],
              "additionalProperties": false
            }
          },
          "failure_fingerprint": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "progress": {
      "type": "object",
      "required": ["required_passed", "required_total", "no_progress_count", "repeated_failure_count", "state_hash"],
      "properties": {
        "required_passed": { "type": "integer", "minimum": 0 },
        "required_total": { "type": "integer", "minimum": 1 },
        "no_progress_count": { "type": "integer", "minimum": 0 },
        "repeated_failure_count": { "type": "integer", "minimum": 0 },
        "oscillation_count": { "type": "integer", "minimum": 0 },
        "state_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "agent_run_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["iteration", "run_id"],
        "properties": {
          "iteration": { "type": "integer", "minimum": 1 },
          "run_id": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "last_decision": {
      "type": "object",
      "required": ["action", "reason_code"],
      "properties": {
        "action": { "enum": ["success", "user_verification_needed", "continue", "recover", "pause", "blocked", "budget_exhausted", "unsafe", "fatal"] },
        "reason_code": { "type": "string", "minLength": 1 },
        "target_condition": { "type": ["string", "null"] },
        "continuation_prompt": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "deferred_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["condition_id", "intent_key", "reason"],
        "properties": {
          "condition_id": {
            "type": "string",
            "pattern": "^SC-[0-9]{3}$"
          },
          "intent_key": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "side_effect_journal": { "type": "array" },
    "applied_results": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          { "type": "integer", "minimum": 1 },
          {
            "type": "object",
            "required": ["iteration"],
            "properties": {
              "iteration": { "type": "integer", "minimum": 1 },
              "payload_hash": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "resumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "reason", "resumed_at"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "resumed_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
