{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-system-task-run.schema.json",
  "title": "Skill System Task Run (Checkpointed Execution)",
  "type": "object",
  "required": ["schema_version", "task_run_id", "objective", "status", "steps", "findings", "final_verification"],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "task_run_id": { "type": "string", "minLength": 1 },
    "work_item_ref": {
      "type": ["string", "null"],
      "pattern": "WI-[0-9]{8}-[0-9]{3}"
    },
    "objective": { "type": "string", "minLength": 1 },
    "work_contract_ref": { "type": "string", "minLength": 1 },
    "work_contract_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "workspace": {
      "type": "object",
      "properties": {
        "root": { "type": "string" },
        "revision": { "type": "string" }
      }
    },
    "status": { "enum": ["active", "complete", "blocked", "cancelled"] },
    "result_label": {
      "enum": ["pending", "agent-verified", "user-verification-needed", "unverified", "blocked"]
    },
    "active_step_id": { "type": ["string", "null"] },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "evidence_refs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "kind": {
            "enum": [
              "core",
              "required_prerequisite",
              "agent_validation",
              "test_authoring",
              "validation_artifact",
              "optional_quality",
              "meta"
            ]
          },
          "required": { "type": "boolean" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "intent_key": { "type": "string", "minLength": 1 },
          "requires_interaction": { "type": "boolean" },
          "status": {
            "enum": ["pending", "in_progress", "complete", "failed", "blocked", "deferred"]
          },
          "deferred_reason": { "type": "string", "minLength": 1 },
          "evidence_refs": { "type": "array", "items": { "type": "object" } }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "comment": "a complete step must carry observed evidence",
            "if": { "properties": { "status": { "const": "complete" } }, "required": ["status"] },
            "then": { "properties": { "evidence_refs": { "minItems": 1 } } }
          },
          {
            "comment": "a deferred step must record why it is not runnable",
            "if": { "properties": { "status": { "const": "deferred" } }, "required": ["status"] },
            "then": { "required": ["deferred_reason"] }
          }
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "status", "evidence_refs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "step_id": { "type": ["string", "null"] },
          "severity": { "enum": ["low", "medium", "high", "critical"] },
          "status": { "enum": ["open", "resolved", "rejected", "accepted_risk"] },
          "evidence_refs": { "type": "array", "items": { "type": "object", "properties": { "kind": { "enum": ["discovery", "resolution", "verification"] } } } },
          "resolution": { "type": "string" },
          "accepted_by": { "enum": ["user", "project_policy"] },
          "reason": { "type": "string" },
          "review_at": { "type": "string" }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "comment": "accepted_risk must record who accepted it, why, and when to revisit",
            "if": { "properties": { "status": { "const": "accepted_risk" } }, "required": ["status"] },
            "then": { "required": ["accepted_by", "reason", "review_at"] }
          },
          {
            "comment": "a resolved finding needs a resolution and observed evidence",
            "if": { "properties": { "status": { "const": "resolved" } }, "required": ["status"] },
            "then": { "required": ["resolution"], "properties": { "evidence_refs": { "minItems": 1 } } }
          }
        ]
      }
    },
    "final_verification": {
      "type": "object",
      "required": ["status", "evidence_refs"],
      "properties": {
        "status": {
          "enum": ["pending", "pass", "user-verification-needed", "unverified"]
        },
        "evidence_refs": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "comment": "a passing final verification must carry observed evidence",
          "if": { "properties": { "status": { "const": "pass" } }, "required": ["status"] },
          "then": { "properties": { "evidence_refs": { "minItems": 1 } } }
        }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": 2 } },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["work_contract_ref", "work_contract_hash", "result_label"]
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "active" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "result_label": { "const": "pending" } }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "blocked" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "result_label": { "const": "blocked" } }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "complete" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "result_label": {
            "enum": ["agent-verified", "user-verification-needed", "unverified"]
          }
        }
      }
    }
  ]
}
