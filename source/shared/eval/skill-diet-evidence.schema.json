{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-system-skill-diet-evidence.schema.json",
  "title": "Skill Diet Paired Run, Output, Verifier, And Admission Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "generated_at",
    "source",
    "model",
    "eval_contract_digest",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "eval_contract_digest": {
      "$ref": "#/$defs/sha256"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/run"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "required": [
        "commit",
        "skills_tree",
        "tracked_input_digest"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "skills_tree": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "tracked_input_digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "artifact_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "utf8_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "utf8_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": [
        "run_id",
        "case_id",
        "skill_id",
        "reviewer_id",
        "case_oracle_sha256",
        "execution_contract_sha256",
        "run_artifact",
        "output_artifact",
        "verifier_receipt",
        "verifier_signature"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "skill_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "case_oracle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "execution_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "run_artifact": {
          "$ref": "#/$defs/artifact_ref"
        },
        "output_artifact": {
          "$ref": "#/$defs/artifact_ref"
        },
        "verifier_receipt": {
          "$ref": "#/$defs/artifact_ref"
        },
        "verifier_signature": {
          "type": "string",
          "pattern": "^[0-9a-f]+$",
          "minLength": 512
        }
      },
      "additionalProperties": false
    }
  }
}
