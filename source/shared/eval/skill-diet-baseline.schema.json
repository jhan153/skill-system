{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-system-skill-diet-baseline.schema.json",
  "title": "Skill System Skill Diet Baseline",
  "type": "object",
  "required": [
    "schema_version",
    "baseline_id",
    "bundle_version",
    "source",
    "measurement_contract",
    "evaluation_contract",
    "aggregates",
    "shared_context_inventory",
    "skills"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "baseline_id": {
      "type": "string",
      "minLength": 1
    },
    "bundle_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source": {
      "type": "object",
      "required": [
        "label",
        "commit",
        "skills_tree",
        "commit_time",
        "reproducible",
        "tracked_input_digest"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "skills_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "commit_time": {
          "type": "string",
          "format": "date-time"
        },
        "reproducible": {
          "const": true
        },
        "tracked_input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "measurement_contract": {
      "type": "object",
      "required": [
        "words",
        "bytes",
        "body",
        "routing_card",
        "reference_admission",
        "observed_admission",
        "observed_admission_scope"
      ]
    },
    "evaluation_contract": {
      "type": "object",
      "required": [
        "case_count",
        "digest"
      ],
      "properties": {
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "aggregates": {
      "type": "object",
      "required": [
        "skill_count",
        "measurements",
        "resources",
        "declared_exact_reference_admission",
        "invocation",
        "eval_gaps",
        "forward_evidence",
        "observed_admission"
      ],
      "properties": {
        "skill_count": {
          "type": "integer",
          "minimum": 1
        },
        "observed_admission": {
          "type": "object",
          "required": [
            "status",
            "words",
            "utf8_bytes",
            "receipt_count"
          ],
          "properties": {
            "status": {
              "const": "unverified"
            },
            "words": {
              "type": "null"
            },
            "utf8_bytes": {
              "type": "null"
            },
            "receipt_count": {
              "const": 0
            }
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "shared_context_inventory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shared_context"
      }
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "required": [
        "words",
        "characters",
        "utf8_bytes"
      ],
      "properties": {
        "words": {
          "type": "integer",
          "minimum": 0
        },
        "characters": {
          "type": "integer",
          "minimum": 0
        },
        "utf8_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resource": {
      "type": "object",
      "required": [
        "path",
        "kind",
        "sha256",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "instruction_reference",
            "script",
            "schema_contract",
            "asset",
            "agent_metadata",
            "other"
          ]
        },
        "consumers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "admission_class": {
          "enum": [
            "must_read_exact",
            "read_if_needed_exact",
            "linked_exact",
            "not_explicitly_named"
          ]
        }
      }
    },
    "shared_context": {
      "type": "object",
      "required": [
        "path",
        "kind",
        "consumers",
        "sha256",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^source/"
        },
        "kind": {
          "enum": [
            "context_routing",
            "shared_doc",
            "shared_schema",
            "shared_script",
            "platform_instruction"
          ]
        },
        "consumers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "object",
          "required": [
            "utf8_bytes"
          ]
        }
      },
      "additionalProperties": false
    },
    "skill": {
      "type": "object",
      "required": [
        "skill_id",
        "source_path",
        "source_sha256",
        "measurements",
        "content_digests",
        "routing",
        "context_targets",
        "resources",
        "eval_coverage",
        "observed_admission"
      ],
      "properties": {
        "skill_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "source_path": {
          "type": "string",
          "pattern": "^source/skills/.+/SKILL\\.md$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "measurements": {
          "type": "object",
          "required": [
            "skill_file",
            "body",
            "routing_card",
            "frontmatter_description",
            "agent_short_description",
            "agent_default_prompt"
          ]
        },
        "content_digests": {
          "type": "object",
          "required": [
            "body",
            "routing_card",
            "frontmatter_description",
            "agent_short_description",
            "agent_default_prompt",
            "context_targets",
            "resource_inventory"
          ]
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "eval_coverage": {
          "type": "object",
          "required": [
            "declared_route_cases",
            "structured_behavior_candidates",
            "structured_observed_candidates",
            "structured_negative_candidates",
            "case_oracle_digests",
            "case_overlay_stable_digests",
            "case_sources",
            "case_required_eval_modes",
            "case_required_evidence_types",
            "case_required_evidence_contracts",
            "case_schema_versions",
            "case_expected_primary_skills",
            "case_expected_supporting_skills",
            "case_should_not_trigger",
            "case_expected_behaviors",
            "case_forbidden_behaviors",
            "case_behavior_contract_owners",
            "case_scenario_tags",
            "edge_status",
            "explicit_edge_cases",
            "observed_primary_run_inventory",
            "current_bundle_run_inventory_ids",
            "current_bundle_source_bound_run_ids",
            "supporting_and_negative_observation"
          ]
        },
        "observed_admission": {
          "type": "object",
          "required": [
            "status",
            "words",
            "utf8_bytes",
            "receipt_ids"
          ],
          "properties": {
            "status": {
              "const": "unverified"
            },
            "words": {
              "type": "null"
            },
            "utf8_bytes": {
              "type": "null"
            },
            "receipt_ids": {
              "type": "array",
              "maxItems": 0
            }
          }
        }
      }
    }
  }
}
